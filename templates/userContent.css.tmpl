@-moz-document url-prefix("view-source:") {
	:root, body {
		background: {{bg}} !important;
		color: {{fg}} !important;
	}
	span[id]::before {
		color: {{overlay1}} !important;
	}
	.start-tag, .end-tag { color: {{cyan}} !important; }
	.comment { color: {{comment}} !important; }
	.cdata, .pi { color: {{purple}} !important; }
	.doctype, .markupdeclaration { color: {{fg_dim}} !important; }
	.entity { color: {{yellow}} !important; }
	.attribute-name { color: {{blue}} !important; }
	.attribute-value { color: {{green}} !important; }
	.error { color: {{red}} !important; background: rgba(251, 73, 52, 0.2) !important; }
}

/* PDF-просмотрщик: тот же набор дизайн-токенов, что и в хроме -
   применяем semantic-блок из userChrome (регенерируется вместе с ним). */
@-moz-document url-prefix("resource://pdf.js/") {
  :root, body {
{{CHROME_THEME_VARS}}
  }
}

@-moz-document url-prefix("about:reader") {
  body {
    --main-background: {{bg}} !important;
    --main-foreground: {{fg}} !important;
    --link-foreground: {{blue}} !important;
    --link-color: {{blue}} !important;
    --link-color-hover: {{punct}} !important;
    --link-selected-background: {{selection}} !important;
    --link-selected-foreground: {{punct}} !important;
    --icon-fill: {{fg}} !important;
    --icon-disabled-fill: {{comment}} !important;
    --outline-focus-color: {{cyan}} !important;
    --gray-theme-background: {{lift}} !important;
    --gray-theme-foreground: {{fg}} !important;
    --dark-theme-background: {{bg}} !important;
    --dark-theme-foreground: {{fg}} !important;
  }
}

/* DevTools: своя тема --theme-* (variables.css) + фотон-примитивы, палитра zenbox_dark. */
@-moz-document url-prefix("chrome://devtools/"), url-prefix("about:devtools-toolbox"), url-prefix("about:debugging") {
  :root {
{{DEVTOOLS_VARS}}
  }
}

/* DevTools, добивка: токены отладчика (paused/inline-preview), сетевого монитора
   (status-code/waterfall timing) и JSON-viewer (те же --theme-* на resource://). */
@-moz-document url-prefix("chrome://devtools/"), url-prefix("about:devtools-toolbox"),
               url-prefix("about:debugging"), url-prefix("resource://devtools") {
  :root {
{{DEVTOOLS_EXTRA_VARS}}
  }
}
